
@model DemoMVC.Models.SinhVien

@{
    ViewData["Title"] = "Sửa sinh viên";
}

<h1>Sửa sinh viên</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit"
              asp-route-id="@Model.MaSV"
              method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="MaSV" />

            <div class="mb-3">
                <label class="form-label">Mã sinh viên</label>
                <input value="@Model.MaSV"
                       class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="HoTen" class="form-label"></label>
                <input asp-for="HoTen" class="form-control" />
                <span asp-validation-for="HoTen"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NgaySinh" class="form-label"></label>
                <input asp-for="NgaySinh" type="date"
                       class="form-control" />
                <span asp-validation-for="NgaySinh"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MaKhoa" class="form-label"></label>
                <select asp-for="MaKhoa"
                        asp-items="ViewBag.MaKhoa"
                        class="form-select">
                    <option value="">-- Chọn khoa --</option>
                </select>
                <span asp-validation-for="MaKhoa"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Cập nhật
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Quay lại
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
