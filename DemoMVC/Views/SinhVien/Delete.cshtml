
@model DemoMVC.Models.SinhVien

@{
    ViewData["Title"] = "Xóa sinh viên";
}

<h1>Xóa sinh viên</h1>

<div class="alert alert-warning">
    Bạn có chắc chắn muốn xóa sinh viên này không?
</div>

<hr />

<dl class="row">
    <dt class="col-sm-3">Mã sinh viên</dt>
    <dd class="col-sm-9">@Model.MaSV</dd>

    <dt class="col-sm-3">Họ tên</dt>
    <dd class="col-sm-9">@Model.HoTen</dd>

    <dt class="col-sm-3">Ngày sinh</dt>
    <dd class="col-sm-9">
        @(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "")
    </dd>

    <dt class="col-sm-3">Khoa</dt>
    <dd class="col-sm-9">
        @(Model.Khoa?.TenKhoa ?? "Chưa có khoa")
    </dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.MaSV" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="id" value="@Model.MaSV" />

    <button type="submit" class="btn btn-danger">
        Xác nhận xóa
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Hủy
    </a>
</form>
